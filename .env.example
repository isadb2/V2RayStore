# ═══════════════════════════════════════════════════
# متغیرهای محیطی — این فایل را روی Railway در بخش Variables وارد کنید
# ═══════════════════════════════════════════════════

# توکن ربات از @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# آدرس دیتابیس PostgreSQL از Railway (به شکل postgresql://user:pass@host:port/db)
DATABASE_URL=postgresql://user:password@host:5432/railway

# آیدی عددی ادمین‌ها با کاما جدا شوند
ADMIN_USERS=123456789,987654321

# آدرس کیف پول USDT/TRC20 برای دریافت پرداخت‌ها
USDT_WALLET_ADDRESS=TYourWalletAddressHere

# نوع ارز دیجیتال
CRYPTO_CURRENCY=USDT_TRC20

# آدرس عمومی Railway برای Webhook (مثال: https://your-app.up.railway.app)
# اگر خالی بگذارید، حالت Polling فعال می‌شود (فقط برای تست)
WEBHOOK_URL=https://your-app.up.railway.app

# پورت (Railway این را خودش تنظیم می‌کند، معمولاً نیازی به تغییر ندارد)
PORT=8443
